# Contact form email delivery (optional until you're ready).
# 1) Create a free account at https://resend.com and an API key
# 2) Add these in Vercel → Project → Settings → Environment Variables
RESEND_API_KEY=
CONTACT_TO_EMAIL=you@yourorg.org
# Until you verify your domain in Resend, keep this as-is:
CONTACT_FROM_EMAIL=Website <onboarding@resend.dev>
